    {
      "id": "awkward",
      "name": "Awkward: Office malfunctions",
      "risk_level": 2,
      "templates": [
        {
          "id": "awkward_01",
          "text": "I accidentally replied-all with {{message}}, and now I can't stop apologizing to the office plants.",
