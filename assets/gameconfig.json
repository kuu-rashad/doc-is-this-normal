    {
      "id": "mild",
      "name": "Mild: Everyday weirdness",
      "risk_level": 1,
      "templates": [
        {
          "id": "mild_01",
          "text": "Whenever I open my inbox, I get an uncontrollable urge to {{urge_action}}.",
          "slots": {
            "urge_action": {
              "hint": "An action",
              "options": [
                "lick a battery",
                "sing opera",
                "speak like a pirate",
                "throw my laptop into the sea",
                "fake my own death",
                "become a goat farmer",
                "moonwalk out of the room",
                "apologize to the furniture"
              ]
            }
          }
        },
        {
          "id": "mild_02",
          "text": "It started small. First I could only bend spoons. Now I can {{big_ability}}, and my neighbors are concerned.",
          "slots": {
            "big_ability": {
              "hint": "An alarming ability",
              "options": [
                "bend lampposts with my mind",
                "fly to the grocery store",
                "summon pigeons at will",
                "control every printer in the building",
                "see through walls",
                "levitate the neighbor's car",
                "melt cutlery by staring at it",
                "hear what their houseplants think"
              ]
            }
          }
        },
        {
          "id": "mild_03",
          "text": "I've tried yoga, therapy and essential oils, but I still scream every time I see {{trigger}}.",
          "slots": {
            "trigger": {
              "hint": "Something you see",
              "options": [
                "a pigeon",
                "a spreadsheet",
                "my landlord",
                "a man in a fedora",
                "the color beige",
                "a Gantt chart",
                "an unread Slack thread",
                "a clown on a unicycle"
              ]
            }
          }
        },
        {
          "id": "mild_04",
          "text": "My cat has started {{pet_behavior}}, and I think it's contagious, because yesterday I did it too.",
          "slots": {
            "pet_behavior": {
              "hint": "Something your cat does (-ing)",
              "options": [
                "barking at the mailman",
                "hiding my car keys",
                "licking the windows",
                "judging my outfits",
                "sleeping in the dishwasher",
                "eating socks",
                "knocking my coffee off the desk",
                "staring at the wall for hours"
              ]
            }
          }
        },
        {
          "id": "mild_05",
          "text": "Every time I get a Slack notification from {{coworker}}, I pee a little before I've even read it.",
          "slots": {
            "coworker": {
              "hint": "A coworker, ideally someone here tonight",
              "options": [
                "my manager",
                "the CEO",
                "HR, who is on leave",
                "the intern",
                "IT support",
                "that one guy from Finance",
                "the client",
                "my team lead"
              ]
            }
          }
        }
