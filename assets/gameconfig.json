  "prescriptions": {
    "_about": "Fill-in-the-blank prescriptions. Each frame has one blank and its own Surprise me options.",
    "templates": [
      {
        "id": "rx_01",
        "text": "Sounds like you need {{cure}}.",
        "slots": {
          "cure": {
            "options": [
              "an exorcism",
              "a hug from HR",
              "a vacation from your own brain",
              "emotional support pigeons",
              "a new personality"
            ]
          }
        }
      },
      {
        "id": "rx_02",
        "text": "{{cure}} should do it.",
        "slots": {
          "cure": {
            "options": [
              "duct tape",
              "a goat",
              "leeches",
              "a Jira ticket",
              "three espressos"
            ]
          }
        }
      },
      {
        "id": "rx_03",
        "text": "I'm afraid you'll have to {{action}}.",
        "slots": {
          "action": {
            "options": [
              "marry the office plant",
              "join a monastery",
              "fake your own death",
              "apologize to the printer",
              "move back in with your parents"
            ]
          }
        }
      },
      {
        "id": "rx_04",
        "text": "The only thing I can prescribe for you is {{cure}}.",
        "slots": {
          "cure": {
            "options": [
              "a priest",
              "more cowbell",
              "a sauna and a long silence",
              "a mute button for your whole life",
              "a stern talking-to"
            ]
          }
        }
      },
      {
        "id": "rx_06",
        "text": "Go home, {{action}}, and stop googling your symptoms.",
        "slots": {
          "action": {
            "options": [
              "touch grass",
              "scream into a pillow",
              "call your mother",
              "write a haiku about it",
              "unplug your router"
            ]
          }
        }
      },
      {
        "id": "rx_07",
        "text": "Take {{take}} and call me in the morning.",
        "slots": {
          "take": {
            "options": [
              "my hand",
              "your pants off",
              "a long hard look at yourself",
              "a hint",
              "the rest of the year off"
            ]
          }
        }
      },
      {
        "id": "rx_08",
        "text": "Before we continue, I'll need you to take off {{off}}.",
        "slots": {
          "off": {
            "options": [
              "your pants",
              "that attitude",
              "your tinfoil hat",
              "that ridiculous lanyard",
              "your socks, slowly"
            ]
          }
        }
      },
      {
        "id": "rx_09",
        "text": "Rub {{rub}} on it twice a day.",
        "slots": {
          "rub": {
            "options": [
              "some butter",
              "your ex's tears",
              "a rotisserie chicken",
              "the intern",
              "a warm spoon"
            ]
          }
        }
      },
      {
        "id": "rx_10",
        "text": "Open wide and say {{say}}.",
        "slots": {
          "say": {
            "options": [
              "ahh",
              "the safe word",
              "goodbye to your dignity",
              "that again, slower",
              "what you said at the Christmas party"
            ]
          }
        }
      },
      {
        "id": "rx_11",
        "text": "Have you tried turning {{turn}} off and on again?",
        "slots": {
          "turn": {
            "options": [
              "yourself",
              "your marriage",
              "your manager",
              "your personality",
              "the whole company"
            ]
          }
        }
      },
      {
        "id": "rx_12",
        "text": "I'll need to examine your {{yours}} more closely.",
        "slots": {
          "yours": {
            "options": [
              "browser history",
              "love life",
              "left buttock",
              "Spotify Wrapped",
              "life choices"
            ]
          }
        }
      },
      {
        "id": "rx_13",
        "text": "Swallow {{swallow}} and don't tell HR.",
        "slots": {
          "swallow": {
            "options": [
              "your pride",
              "the evidence",
              "the USB stick",
              "the whole thing",
              "your feelings"
            ]
          }
        }
      },
      {
        "id": "rx_14",
        "text": "I'm prescribing {{cure}}, to be taken rectally.",
        "slots": {
          "cure": {
            "options": [
              "a rubber duck",
              "a fax machine",
              "a bigger monitor",
              "a raise",
              "a weighted blanket and a lawyer"
            ]
          }
        }
      }
    ]
  },
  "categories": [
    {
      "id": "mild",
      "name": "Mild: Everyday weirdness",
      "risk_level": 1,
      "templates": [
        {
          "id": "mild_01",
          "text": "Whenever I open my inbox, I get an uncontrollable urge to {{urge_action}}.",
          "slots": {
            "urge_action": {
              "options": [
                "quit my job",
                "throw my laptop out of the window",
                "fake my own death",
                "become a goat farmer",
                "move to a cabin in the woods"
              ]
            }
          }
        },
        {
          "id": "mild_02",
          "text": "It started small. First I could only bend spoons. Now I can {{big_ability}}, and my neighbors are concerned.",
          "slots": {
            "big_ability": {
              "options": [
                "bend lampposts with my mind",
                "fly to the grocery store",
                "summon pigeons at will",
                "control every printer in the building",
                "see through walls"
              ]
            }
          }
        },
        {
          "id": "mild_03",
          "text": "I've tried yoga, therapy and essential oils, but I still scream every time I see {{trigger}}.",
          "slots": {
            "trigger": {
              "options": [
                "a pigeon",
                "a spreadsheet",
                "my landlord",
                "a man in a fedora",
                "the color beige"
              ]
            }
          }
        },
        {
          "id": "mild_04",
          "text": "My cat has started {{pet_behavior}}, and I think it's contagious, because yesterday I did it too.",
          "slots": {
            "pet_behavior": {
              "options": [
                "barking at the mailman",
                "hiding my car keys",
                "licking the windows",
                "judging my outfits",
                "sleeping in the dishwasher"
              ]
            }
          }
        },
        {
          "id": "mild_05",
          "text": "Every time I get a Slack notification from {{coworker}}, I pee a little before I've even read it.",
          "slots": {
            "coworker": {
              "options": [
                "my manager",
                "the CEO",
                "HR, who is on leave",
                "the intern",
                "IT support"
              ]
            }
          }
        },
        {
          "id": "mild_06",
          "text": "My whole body aches whenever I have to deal with {{hassle}}.",
          "slots": {
            "hassle": {
              "options": [
                "Monday mornings",
                "the shared fridge",
                "my landlord",
                "a 47-slide deck",
                "IKEA instructions"
              ]
            }
          }
        },
        {
          "id": "mild_07",
          "text": "My energy disappears whenever I have to deal with {{drain}}.",
          "slots": {
            "drain": {
              "options": [
                "small talk in the elevator",
                "a client's \"quick change\"",
                "my inbox",
                "Excel macros",
                "the group chat"
              ]
            }
          }
        },
        {
          "id": "mild_08",
          "text": "Bedtime has become a staring contest with the ceiling, thanks to {{worry}}.",
          "slots": {
            "worry": {
              "options": [
                "tomorrow's standup",
                "a typo I sent the CEO",
                "that weird noise in the attic",
                "three espressos at 4 pm",
                "an unanswered \"we need to talk\""
              ]
            }
          }
        },
        {
          "id": "mild_09",
          "text": "People keep asking why I walk as if I'm {{walk}}.",
          "slots": {
            "walk": {
              "options": [
                "late for a train",
                "a cowboy who lost his horse",
                "carrying an invisible tray",
                "being chased by bees",
                "wading through soup"
              ]
            }
          }
        },
        {
          "id": "mild_10",
          "text": "Since the office hamster bit me, I have been permanently {{hamster_state}}.",
          "slots": {
            "hamster_state": {
              "options": [
                "running on a wheel at night",
                "hoarding snacks in my cheeks",
                "suspicious of the vacuum",
                "sleepy until 6 pm",
                "nibbling on cables"
              ]
            }
          }
        },
        {
          "id": "mild_11",
          "text": "I'm still struggling with {{struggle}}; it happens almost every day.",
          "slots": {
            "struggle": {
              "options": [
                "waving back at strangers",
                "saying \"you too\" to the waiter",
                "forgetting why I walked in",
                "replying-all by accident",
                "laughing at my own typos"
              ]
            }
          }
        },
        {
          "id": "mild_12",
          "text": "My coworkers keep asking why I am {{oddity}}. I was hoping you could explain it.",
          "slots": {
            "oddity": {
              "options": [
                "whispering to the coffee machine",
                "wearing sunglasses indoors",
                "sitting under my desk",
                "speaking only in emojis",
                "humming the Nokia ringtone"
              ]
            }
          }
        },
        {
          "id": "mild_13",
          "text": "My relatives and I all have the same problem: we cannot stop {{family_habit}}.",
          "slots": {
            "family_habit": {
              "options": [
                "clapping when the plane lands",
                "arguing about the dishwasher",
                "saving plastic bags",
                "pointing at cows from the car",
                "laughing at funerals"
              ]
            }
          }
        },
        {
          "id": "mild_14",
          "text": "I have stopped enjoying {{joy}}, even though it used to be my favourite thing.",
          "slots": {
            "joy": {
              "options": [
                "pizza",
                "long walks on the beach",
                "karaoke",
                "the sound of rain",
                "naps"
              ]
            }
          }
        }
      ],
