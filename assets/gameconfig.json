            "message": {
              "hint": "Something you sent",
              "options": [
                "a bathroom selfie",
                "my honest opinion of the roadmap",
                "a single eggplant emoji",
                "my grocery list",
                "a love poem meant for my partner",
                "a four-minute voice memo",
                "“who even reads these?”",
                "my salary spreadsheet"
              ]
            }
          }
        },
        {
          "id": "awkward_02",
          "text": "My Slack status has been stuck on \"{{status}}\" for weeks, and I've started to believe it.",
          "slots": {
            "status": {
              "hint": "A Slack status",
              "options": [
                "In a meeting",
                "Out sick",
                "On vacation 🏖️",
                "Do not disturb",
                "Focusing",
                "Living my best life",
                "Hiding from the client",
                "Probably napping"
              ]
            }
          }
        },
        {
          "id": "awkward_03",
          "text": "I physically can't stop calling my manager {{wrong_name}}. It's been going on for three months.",
          "slots": {
            "wrong_name": {
              "hint": "A name or title",
              "options": [
                "Mom",
                "Dad",
                "Your Majesty",
                "Coach",
                "babe",
                "Captain",
                "Sensei",
                "Grandma"
              ]
            }
          }
        },
        {
          "id": "awkward_04",
          "text": "During my performance review I {{embarrassing_action}}. Lucky for me our HR is on leave.",
          "slots": {
            "embarrassing_action": {
              "hint": "Something embarrassing you did",
              "options": [
                "cried a little",
                "called my manager “Mom”",
                "fell asleep",
                "ate a whole rotisserie chicken",
                "asked for a hug",
                "negotiated in a pirate accent",
                "shared my screen with Tinder open",
                "burped the alphabet"
              ]
            }
          }
        },
        {
          "id": "awkward_05",
          "text": "I can only give client presentations while {{condition}}. They haven't noticed yet.",
          "slots": {
            "condition": {
              "hint": "A situation or state",
              "options": [
                "standing on one leg",
                "wearing a cape",
                "eating soup",
                "holding my cat",
                "lying on the floor",
                "sitting in a bathtub",
                "wearing no pants",
                "whispering"
              ]
            }
          }
        }
      ]
