{
  "game_title": "Doc, is this normal?",
  "placeholder_format": "{{slot_id}}",
  "categories": [
    {
      "id": "mild",
      "name": "Mild: Everyday weirdness",
      "risk_level": 1,
      "templates": [
        {
          "id": "mild_01",
          "text": "Whenever I {{trigger_action}}, I get an uncontrollable urge to {{urge_action}}.",
          "slots": {
            "trigger_action": {
              "hint": "Something you do",
              "options": [
                "open my inbox",
                "hear my alarm",
                "see a pigeon",
                "smell fresh bread",
                "check my bank account",
                "step into an elevator",
                "get a group chat notification",
                "walk past a mirror"
              ]
            },
            "urge_action": {
              "hint": "An action",
              "options": [
                "sing opera",
                "lick a battery",
                "do a cartwheel",
                "speak like a pirate",
                "hug a stranger",
                "eat a raw onion",
                "moonwalk",
                "apologize to the furniture"
              ]
            }
          }
        },
        {
          "id": "mild_02",
          "text": "It started small. First I could only {{small_ability}}. Now I can {{big_ability}}, and my neighbors are concerned.",
          "slots": {
            "small_ability": {
              "hint": "A tiny weird ability",
              "options": [
                "wiggle my ears",
                "bend spoons a little",
                "talk to pigeons",
                "hover an inch off the ground",
                "smell the Wi-Fi",
                "predict when the bus is late",
                "glow faintly in the dark",
                "hear what my houseplants think"
              ]
            },
            "big_ability": {
              "hint": "A big alarming ability",
              "options": [
                "fly to the grocery store",
                "bend lampposts with my mind",
                "speak fluent dolphin",
                "summon pigeons at will",
                "turn invisible on Mondays",
                "control every printer in the building",
                "see through walls",
                "set things on fire by sneezing"
              ]
            }
          }
        },
        {
          "id": "mild_03",
          "text": "I've tried {{failed_remedy}}, but I still {{reaction}} every time I see {{trigger}}.",
          "slots": {
            "failed_remedy": {
              "hint": "Something you tried",
              "options": [
                "yoga",
                "therapy",
                "a juice cleanse",
                "hypnosis",
                "cold showers",
                "essential oils",
                "turning myself off and on again",
                "screaming into a pillow"
              ]
            },
            "reaction": {
              "hint": "How you react",
              "options": [
                "burst into tears",
                "start meowing",
                "do a little dance",
                "sneeze uncontrollably",
                "faint dramatically",
                "salute",
                "hiss",
                "break into song"
              ]
            },
            "trigger": {
              "hint": "Something you see",
              "options": [
                "a pigeon",
                "a spreadsheet",
                "my landlord",
                "a clown",
                "a pineapple",
                "the color beige",
                "a man in a fedora",
                "an open laptop"
              ]
            }
          }
        },
        {
          "id": "mild_04",
          "text": "My {{pet}} has started {{pet_behavior}}, and I think it's contagious, because yesterday I {{my_behavior}}.",
          "slots": {
            "pet": {
              "hint": "A pet",
              "options": [
                "cat",
                "dog",
                "goldfish",
                "hamster",
                "parrot",
                "tortoise",
                "houseplant",
                "robot vacuum"
              ]
            },
            "pet_behavior": {
              "hint": "What your pet does (-ing)",
              "options": [
                "barking at the moon",
                "hiding my car keys",
                "watching the news",
                "doing yoga",
                "judging my outfits",
                "sleeping in the dishwasher",
                "eating socks",
                "staring at the wall for hours"
              ]
            },
            "my_behavior": {
              "hint": "What you did yesterday",
              "options": [
                "chased a squirrel",
                "licked my own hand",
                "buried a bone in the garden",
                "hissed at the mailman",
                "napped in a sunbeam for six hours",
                "knocked a glass off the table",
                "fetched the newspaper with my mouth",
                "sniffed a stranger"
              ]
            }
          }
        },
        {
          "id": "mild_05",
          "text": "Every time I get a Slack notification from {{coworker}}, I {{reaction}} before I've even read it.",
          "slots": {
            "coworker": {
              "hint": "A coworker",
              "options": [
                "my manager",
                "the CEO",
                "HR",
                "the intern",
                "IT support",
                "that one guy from Finance",
                "the client",
                "my team lead"
              ]
            },
            "reaction": {
              "hint": "How you react",
              "options": [
                "sigh loudly",
                "break into a cold sweat",
                "start typing “sounds good!”",
                "hide under my desk",
                "slam my laptop shut",
                "scream internally",
                "update my CV",
                "put on noise-cancelling headphones"
              ]
            }
          }
        }
      ],
      "premade_symptoms": [
        {
          "id": "premade_v2_01",
          "template_id": "mild_01",
          "slots": {
            "trigger_action": "check my bank account",
            "urge_action": "moonwalk"
          }
        },
        {
          "id": "premade_v2_02",
          "template_id": "mild_02",
          "slots": {
            "small_ability": "talk to pigeons",
            "big_ability": "summon pigeons at will"
          }
        },
        {
          "id": "premade_v2_03",
          "template_id": "mild_02",
          "slots": {
            "small_ability": "smell the Wi-Fi",
            "big_ability": "control every printer in the building"
          }
        },
        {
          "id": "premade_v2_04",
          "template_id": "mild_03",
          "slots": {
            "failed_remedy": "hypnosis",
            "reaction": "start meowing",
            "trigger": "a spreadsheet"
          }
        },
        {
          "id": "premade_v2_05",
          "template_id": "mild_03",
          "slots": {
            "failed_remedy": "essential oils",
            "reaction": "salute",
            "trigger": "the color beige"
          }
        },
        {
          "id": "premade_v2_06",
          "template_id": "mild_04",
          "slots": {
            "pet": "goldfish",
            "pet_behavior": "judging my outfits",
            "my_behavior": "hissed at the mailman"
          }
        },
        {
          "id": "premade_v2_07",
          "template_id": "mild_04",
          "slots": {
            "pet": "robot vacuum",
            "pet_behavior": "eating socks",
            "my_behavior": "napped in a sunbeam for six hours"
          }
        },
        {
          "id": "premade_v2_08",
          "template_id": "mild_05",
          "slots": {
            "coworker": "that one guy from Finance",
            "reaction": "hide under my desk"
          }
        }
      ]
    },
    {
      "id": "awkward",
      "name": "Awkward: Office malfunctions",
      "risk_level": 2,
      "templates": [
        {
          "id": "awkward_01",
          "text": "I accidentally replied-all to {{recipient}} with {{message}}, and now I can't stop {{compulsion}}.",
          "slots": {
            "recipient": {
              "hint": "A group of people"
            },
            "message": {
              "hint": "Something you sent"
            },
            "compulsion": {
              "hint": "An action ending in -ing"
            }
          }
        },
        {
          "id": "awkward_02",
          "text": "My Slack status has been stuck on {{status}} for weeks, and I've started to believe it.",
          "slots": {
            "status": {
              "hint": "A Slack status"
            }
          }
        },
        {
          "id": "awkward_03",
          "text": "I physically can't stop calling my manager {{wrong_name}}. It's been going on for {{duration}}.",
          "slots": {
            "wrong_name": {
              "hint": "A name or title"
            },
            "duration": {
              "hint": "A length of time"
            }
          }
        },
        {
          "id": "awkward_04",
          "text": "During my performance review I {{embarrassing_action}}. Lucky for me our HR is on leave.",
          "slots": {
            "embarrassing_action": {
              "hint": "Something embarrassing you did"
            }
          }
        },
        {
          "id": "awkward_05",
          "text": "I can only give presentations while {{condition}}. Last quarter's results were presented to {{audience}}.",
          "slots": {
            "condition": {
              "hint": "A situation or state"
            },
            "audience": {
              "hint": "An audience"
            }
          }
        }
      ]
    },
    {
      "id": "gross",
      "name": "Gross: Bodies behaving badly",
      "risk_level": 3,
      "templates": [
        {
          "id": "gross_01",
          "text": "I can't use the bathroom unless I {{bathroom_ritual}} while thinking about {{thought}}.",
          "slots": {
            "bathroom_ritual": {
              "hint": "An action"
            },
            "thought": {
              "hint": "A person, topic, or thing"
            }
          }
        },
        {
          "id": "gross_02",
          "text": "I sweat {{substance}} whenever I'm near {{trigger}}.",
          "slots": {
            "substance": {
              "hint": "A substance"
            },
            "trigger": {
              "hint": "A person, place, or thing"
            }
          }
        },
        {
          "id": "gross_03",
          "text": "Every time I go to the dentist, they find {{object}} in my {{location}}, and they're starting to ask questions.",
          "slots": {
            "object": {
              "hint": "Something unexpected"
            },
            "location": {
              "hint": "A part of your mouth or body"
            }
          }
        },
        {
          "id": "gross_04",
          "text": "Every time I {{trigger_action}}, I shart a little, and I'm running out of people to blame besides {{scapegoat}}.",
          "slots": {
            "trigger_action": {
              "hint": "Something you do"
            },
            "scapegoat": {
              "hint": "Someone to blame"
            }
          }
        },
        {
          "id": "gross_05",
          "text": "I've been saving my {{bodily_substance}} in a jar labeled {{label}}. Is that a hobby?",
          "slots": {
            "bodily_substance": {
              "hint": "Something your body makes"
            },
            "label": {
              "hint": "A jar label"
            }
          }
        },
        {
          "id": "gross_06",
          "text": "I found {{object}} somewhere it absolutely should not be, and I have no memory of how it got there.",
          "slots": {
            "object": {
              "hint": "An object"
            }
          }
        },
        {
          "id": "gross_07",
          "text": "Whenever a client asks for \"one small change\", I start sweating {{substance}} from my {{body_part}}.",
          "slots": {
            "substance": {
              "hint": "A substance"
            },
            "body_part": {
              "hint": "A body part"
            }
          }
        }
      ]
    },
    {
      "id": "spicy",
      "name": "Spicy: Flirting malfunctions",
      "risk_level": 4,
      "templates": [
        {
          "id": "spicy_01",
          "text": "The moment someone touches my {{body_part}}, I forget how to {{forgotten_action}}.",
          "slots": {
            "body_part": {
              "hint": "A body part"
            },
            "forgotten_action": {
              "hint": "An action"
            }
          }
        },
        {
          "id": "spicy_02",
          "text": "Every time I try to look sexy, I end up looking like {{comparison}} doing {{activity}}.",
          "slots": {
            "comparison": {
              "hint": "A person or creature"
            },
            "activity": {
              "hint": "An activity"
            }
          }
        },
        {
          "id": "spicy_03",
          "text": "My crush said {{compliment}}, and my {{body_part}} hasn't stopped {{reaction}} since.",
          "slots": {
            "compliment": {
              "hint": "Something your crush said"
            },
            "body_part": {
              "hint": "A body part"
            },
            "reaction": {
              "hint": "An action ending in -ing"
            }
          }
        },
        {
          "id": "spicy_04",
          "text": "I keep accidentally sending voice memos of me {{embarrassing_activity}} to {{recipient}}. It's happened four times this week.",
          "slots": {
            "embarrassing_activity": {
              "hint": "An activity ending in -ing"
            },
            "recipient": {
              "hint": "A person or group"
            }
          }
        },
        {
          "id": "spicy_05",
          "text": "I get way too excited whenever I {{innocent_activity}}. I've already been banned from {{place}}.",
          "slots": {
            "innocent_activity": {
              "hint": "An innocent activity"
            },
            "place": {
              "hint": "A place"
            }
          }
        },
        {
          "id": "spicy_06",
          "text": "I get weirdly turned on whenever {{coworker}} shares their screen, especially when they open {{app_or_file}}.",
          "slots": {
            "coworker": {
              "hint": "A coworker"
            },
            "app_or_file": {
              "hint": "An app or file"
            }
          }
        },
        {
          "id": "spicy_07",
          "text": "I keep sending flirty Slack DMs meant for {{intended_recipient}} to the client channel. The client keeps replying {{client_reply}}.",
          "slots": {
            "intended_recipient": {
              "hint": "Who the messages were for"
            },
            "client_reply": {
              "hint": "The client's reply"
            }
          }
        }
      ]
    },
    {
      "id": "after_hours",
      "name": "After hours: Questionable bedroom behavior",
      "risk_level": 5,
      "templates": [
        {
          "id": "after_hours_01",
          "text": "I can't get in the mood unless my partner is wearing {{clothing}} and holding {{held_object}}.",
          "slots": {
            "clothing": {
              "hint": "Clothing or an outfit"
            },
            "held_object": {
              "hint": "Something you can hold"
            }
          }
        },
        {
          "id": "after_hours_02",
          "text": "My partner and I tried {{position}}, and now we both need a chiropractor and {{professional}}.",
          "slots": {
            "position": {
              "hint": "A position or move"
            },
            "professional": {
              "hint": "A professional"
            }
          }
        },
        {
          "id": "after_hours_03",
          "text": "I can only climax while thinking about {{unsexy_thing}}.",
          "slots": {
            "unsexy_thing": {
              "hint": "Something very unsexy"
            }
          }
        },
        {
          "id": "after_hours_04",
          "text": "We role-played as {{roleplay}}, and now I can't {{everyday_activity}} without getting aroused.",
          "slots": {
            "roleplay": {
              "hint": "A role-play pairing"
            },
            "everyday_activity": {
              "hint": "An everyday activity"
            }
          }
        }
      ]
    }
  ]
}
