{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DOC_GAME", "class_name": "DocGame" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocGame"] }]
}
