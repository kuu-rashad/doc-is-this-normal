{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DOC_GAME", "class_name": "DocGame" }]
  },
  // Storage migrations run once each, in order, and must never be edited after deploying.
  // v1 created the storage under the original class name; v2 renamed the class, keeping its data.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Game"] },
    { "tag": "v2", "renamed_classes": [{ "from": "Game", "to": "DocGame" }] }
  ]
}
